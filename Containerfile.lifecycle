FROM docker.io/library/busybox:stable-musl@sha256:3c6ae8008e2c2eedd141725c30b20d9c36b026eb796688f88205845ef17aa213 AS tools

FROM scratch AS runtime

ARG IMAGE_CREATED
ARG IMAGE_REVISION
ARG IMAGE_VERSION

LABEL org.opencontainers.image.title="ConClear Drill: lifecycle fixture"
LABEL org.opencontainers.image.description="Deterministic service image for ConClear's repeat-release lifecycle test; not for production use"
LABEL org.opencontainers.image.vendor="foundata GmbH"
LABEL org.opencontainers.image.source="https://foundata.com/en/projects/oci-conclear-drill/#source"
LABEL org.opencontainers.image.url="https://foundata.com/en/projects/oci-conclear-drill/"
LABEL org.opencontainers.image.documentation="https://foundata.com/en/projects/oci-conclear-drill/#doc"
LABEL org.opencontainers.image.created="${IMAGE_CREATED}"
LABEL org.opencontainers.image.revision="${IMAGE_REVISION}"
LABEL org.opencontainers.image.version="${IMAGE_VERSION}"

# The repeat-release test requires the same revision to rebuild to the same
# digest, so this image runs no build step at all: package managers write logs
# and status files whose content differs on every run. A distribution base is
# unusable for a second reason: its packages accumulate fixable vulnerabilities
# that only an upgrade fixes, and an upgrade is a build step. BusyBox and its
# applet links are therefore copied whole onto an empty image; ConClear's
# runtime probes need a shell, `stat`, `readlink` and `sleep` inside the
# container.
COPY --from=tools --chown=0:0 /bin /bin
COPY --chown=0:0 --chmod=0555 scripts/lifecycle-entrypoint.sh /usr/local/lib/conclear-drill/entrypoint.sh
COPY --chown=0:0 --chmod=0555 scripts/lifecycle-healthcheck.sh /usr/local/lib/conclear-drill/healthcheck.sh

USER 1001:1001

ENTRYPOINT ["/usr/local/lib/conclear-drill/entrypoint.sh"]
