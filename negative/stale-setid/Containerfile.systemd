FROM docker.io/library/debian:13-slim@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132 AS runtime

ARG IMAGE_CREATED
ARG IMAGE_REVISION
ARG IMAGE_VERSION

LABEL org.opencontainers.image.title="ConClear Drill: systemd"
LABEL org.opencontainers.image.description="Synthetic systemd image with one drill unit that exercises the ConClear systemd profile; not for production use"
LABEL org.opencontainers.image.vendor="foundata GmbH"
LABEL org.opencontainers.image.source="https://foundata.com/en/projects/oci-conclear-drill/#source"
LABEL org.opencontainers.image.url="https://foundata.com/en/projects/oci-conclear-drill/"
LABEL org.opencontainers.image.documentation="https://foundata.com/en/projects/oci-conclear-drill/#doc"
LABEL org.opencontainers.image.created="${IMAGE_CREATED}"
LABEL org.opencontainers.image.revision="${IMAGE_REVISION}"
LABEL org.opencontainers.image.version="${IMAGE_VERSION}"

# Tell systemd it runs in a container (see src/basic/virt.c).
ENV container=podman

ARG DEBIAN_FRONTEND=noninteractive
# systemd is the init process; procps provides the tools systemd's own
# readiness probes and the drill unit use. Inconvenient units are masked as in
# the integration test target images. Every inherited set-ID bit except su's is
# stripped; su stays as the one declared set-ID executable of the drill.
RUN apt-get update \
  && apt-get upgrade -y --no-install-recommends \
  && apt-get install -y --no-install-recommends \
    procps \
    systemd \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man \
  && systemctl mask \
    console-getty.service \
    getty.target \
    systemd-logind.service \
    systemd-ask-password-console.service \
    systemd-ask-password-wall.service \
    dev-hugepages.mount \
    sys-fs-fuse-connections.mount \
    systemd-remount-fs.service \
    systemd-initctl.service \
    systemd-machine-id-commit.service \
    systemd-random-seed.service \
    systemd-udevd.service \
    systemd-udev-trigger.service \
  && find / -xdev -type f -perm /6000 -exec chmod a-s {} + \
  && install -d -m 0755 /usr/local/lib/conclear-drill

COPY --chown=0:0 --chmod=0555 systemd/drill-loop.sh /usr/local/lib/conclear-drill/drill-loop.sh
COPY --chown=0:0 --chmod=0444 systemd/conclear-drill.service /etc/systemd/system/conclear-drill.service
RUN systemctl enable conclear-drill.service

# Podman declares these itself; stated for the runtime contract and Docker.
VOLUME ["/run", "/run/lock", "/tmp", "/sys/fs/cgroup/systemd", "/var/lib/journal"]

# systemd runs as root; stated numerically for the runtime contract.
USER 0

# systemd shuts down cleanly on SIGRTMIN+3.
STOPSIGNAL SIGRTMIN+3

CMD ["/lib/systemd/systemd"]
